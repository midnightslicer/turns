pkgname=turns
pkgver=0.1.0
pkgrel=1
pkgdesc='A photo slideshow where the people in a folder take turns'
arch=('x86_64' 'aarch64')
url='https://github.com/midnightslicer/turns'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal')
optdepends=('kimageformats: HEIC, AVIF and JPEG XL photos')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/turns "$pkgdir/usr/bin/turns"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/turns.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/turns.svg"
  install -Dm644 "$startdir/turns.desktop" "$pkgdir/usr/share/applications/turns.desktop"
}
